# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=3000
NODE_ENV=development  # development, test, or production

# ===========================================
# POSTGRESQL CONFIGURATION
# ===========================================
# Option 1: Use DATABASE_URL (recommended for production)
# DATABASE_URL=postgres://user:password@host:5432/database

# Option 2: Individual connection parameters (for development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=voteweb
DB_USER=postgres
DB_PASSWORD=your_password_here

# ===========================================
# CONNECTION POOL SETTINGS
# ===========================================
# For 2-3k users, conservative pool sizing is appropriate
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# ===========================================
# SECURITY - SESSION
# ===========================================
# Secret for hashing session tokens (REQUIRED in production)
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-32-char-secret-in-production

# Session TTL in hours (default: 8 hours)
SESSION_TTL_HOURS=8

# ===========================================
# SECURITY - MFA/TOTP
# ===========================================
# Encryption key for TOTP secrets (REQUIRED for MFA)
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# MUST be 32 bytes when decoded (44 characters base64 encoded)
TOTP_ENCRYPTION_KEY=change-this-to-44-char-base64-key-in-prod

# ===========================================
# SECURITY - COOKIES
# ===========================================
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Frontend origin for CORS (do NOT use * in production)
# Development:
CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001
# Production example:
# CORS_ORIGIN=https://your-frontend-domain.com
# FRONTEND_URL=https://your-frontend-domain.com

# Allowed methods (optional)
CORS_METHODS=GET,POST,PATCH,DELETE,OPTIONS

# ===========================================
# DATABASE SSL
# ===========================================
# Set to true for production connections
DB_SSL=false

# ===========================================
# ADMIN AUTHENTICATION (DEPRECATED - USE REAL AUTH)
# ===========================================
# These settings are IGNORED when real authentication is enabled
# They exist only for initial development without auth

# Enable development admin bypass (NEVER enable in production!)
ALLOW_DEV_ADMIN=false

# Development admin student ID (optional)
# DEV_ADMIN_ID=1
